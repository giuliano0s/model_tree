# Template de variáveis de ambiente. Copie para .env e preencha.
#
# Só é necessário para rodar o BACKEND localmente (vercel dev) ou reindexar.
# Quem apenas USA o produto (site no navegador ou MCP via uvx) não precisa de nada disto.

# --- Upstash Vector (banco vetorial) ---
UPSTASH_VECTOR_REST_URL="https://SEU-INDICE.upstash.io"
# full (lê + ESCREVE): só para a indexação local (scripts/index_tree.py). NUNCA vai para a Vercel.
UPSTASH_VECTOR_REST_TOKEN="..."
# read-only (só lê): usado pelas funções /api. É este que vai para a Vercel.
UPSTASH_VECTOR_REST_READONLY_TOKEN="..."

# --- Upstash Redis (gatekeeper de rate-limit) ---
UPSTASH_REDIS_REST_URL="https://SEU-REDIS.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# --- Gemini (LLM do /api/recommend) ---
GEMINI_API_KEY="..."
# opcional: trocar o modelo (default gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# --- Tradução dos dados (scripts/translate_tree.py), opcional ---
CEREBRAS_API_KEY="..."
