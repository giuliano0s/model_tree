# Template de variáveis de ambiente. Copie para .env e preencha.
#
# Só é necessário para rodar o BACKEND localmente (vercel dev) ou reindexar.
# Quem apenas USA o produto (site no navegador ou MCP via uvx) não precisa de nada disto.

# --- Upstash Vector (banco vetorial) ---
UPSTASH_VECTOR_REST_URL="https://SEU-INDICE.upstash.io"
# full (lê + ESCREVE): só para a indexação local (scripts/index_tree.py). NUNCA vai para a Vercel.
UPSTASH_VECTOR_REST_TOKEN="..."
# read-only (só lê): usado pelas funções /api. É este que vai para a Vercel.
UPSTASH_VECTOR_REST_READONLY_TOKEN="..."

# --- Upstash Redis (gatekeeper de rate-limit) ---
UPSTASH_REDIS_REST_URL="https://SEU-REDIS.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# --- Gemini (LLM do /api/chat) ---
GEMINI_API_KEY="..."
# opcional: trocar o modelo (default gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# --- Enriquecimento + tradução dos dados (scripts/enrich_tree.py, translate_tree.py) ---
# chave dedicada para a geração do enrich (Gemini Pro + web) E para a tradução
# (Gemini Flash, default). Só local. Fallback para GEMINI_API_KEY se ausente.
GEMINI_ENRICH_API_KEY="..."

# --- Tradução via Cerebras (opcional, switch) ---
# só usada se TRANSLATE_PROVIDER=cerebras; por padrão a tradução usa o Gemini acima.
CEREBRAS_API_KEY="..."

# --- Benchmark (demo/benchmarks, opcional) ---
# chave OpenAI usada SOMENTE no benchmark de recomendação. Só local, nunca vai para a Vercel.
OPENAI_BENCHMARK_API_KEY="..."
# OPENAI_BENCHMARK_MODEL="gpt-5"   # melhor modelo disponível
